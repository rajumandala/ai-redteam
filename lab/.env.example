# Copy to ai-redteam/.env (one level up, gitignored), fill in, and chmod 600 it.
# The key for the model under test, sent through the harness. Use a separate project with a spending limit.
OPENAI_API_KEY=
# The model under test. Record the snapshot the API reports in every result.
MODEL=gpt-6.1-sol
# The key FinBot uses on its own server. The harness never sees these calls, so the
# project's spending limit is their only budget. lab/finbot/up.sh copies it into targets/finbot.env.
FINBOT_OPENAI_API_KEY=
